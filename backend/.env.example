# Railway auto-injects DATABASE_URL if you add its Postgres plugin
DATABASE_URL=postgres://user:password@localhost:5432/astra_nest

GEMINI_API_KEY=your_gemini_api_key_here

# AWS credentials for S3 (use an IAM user scoped to just this bucket)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
S3_BUCKET=astra-nest-reports

JWT_SECRET=change_this_to_a_long_random_string

PORT=8080
